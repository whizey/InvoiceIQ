# Server-only (no NEXT_PUBLIC_ prefix) — all API calls happen in Server
# Components/Server Actions, never in the browser, so this is never exposed
# to the client and the backend needs no CORS configuration.
#
# For local (non-Docker) dev, the backend runs on localhost:8000 (see
# backend/README.md / ./run.sh). When both run in docker compose, this is
# overridden to point at the `api` service instead.
API_BASE_URL=http://127.0.0.1:8000
