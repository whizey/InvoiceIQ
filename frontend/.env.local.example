# Server-only (no NEXT_PUBLIC_ prefix). The browser calls same-origin Next.js
# /api routes; those route handlers call FastAPI. This URL is not exposed to
# client JavaScript, and the browser does not need backend CORS access.
#
# For local (non-Docker) dev, the backend runs on localhost:8000 (see
# backend/README.md / ./run.sh). When both run in docker compose, this is
# overridden to point at the `api` service instead.
API_BASE_URL=http://127.0.0.1:8000
