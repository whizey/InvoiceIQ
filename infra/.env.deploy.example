# TEMPLATE ONLY. Never commit the real infra/.env.deploy file.
# For locally restricted staging on a single machine. Generate fresh, unique values.
POSTGRES_PASSWORD=replace-with-long-random-password
INVOICEIQ_OPERATOR_API_KEY=replace-with-separate-random-token-at-least-24-characters
INVOICEIQ_METRICS_TOKEN=replace-with-separate-random-collector-token-at-least-24-chars
# Replace UUIDs with actual customer company IDs in the deployed database.
# Use different random tokens for analytics, reviewer and operator access.
ANALYTICS_API_KEYS={"portfolio":{"token":"replace-with-separate-random-analytics-token","company_ids":["00000000-0000-0000-0000-000000000000"]}}
REVIEWER_API_KEYS={"reviewer":"replace-with-separate-random-reviewer-token"}
INVOICEIQ_REVIEWER_COMPANY_SCOPES={"reviewer":["00000000-0000-0000-0000-000000000000"]}
SCHEDULER_ENABLED=false
GOOGLE_API_KEY=
OPENAI_API_KEY=
